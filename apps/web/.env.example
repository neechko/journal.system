# Database (Supabase PostgreSQL)
# Runtime: use the transaction pooler (port 6543) on serverless platforms.
DATABASE_URL=postgres://postgres:[password]@aws-0-region.pooler.supabase.com:6543/postgres
# Migrations/tooling: direct connection (port 5432). Never use the pooler for DDL.
DIRECT_DATABASE_URL=postgres://postgres:[password]@db.<project-ref>.supabase.co:5432/postgres

# Auth (NextAuth.js)
AUTH_URL=http://localhost:3000
AUTH_SECRET=your-auth-secret-generate-with-openssl-rand-base64-32
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://dvkodbuzvtiunhdhatdl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Search (Meilisearch)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-meilisearch-api-key

# PDF Service (Fly.io)
PDF_SERVICE_URL=https://journal-pdf.fly.dev
PDF_SERVICE_API_KEY=your-pdf-service-api-key

# Email (Resend/SendGrid)
EMAIL_FROM=noreply@yourdomain.com
RESEND_API_KEY=your-resend-api-key

# Crossref
CROSSREF_USERNAME=your-crossref-username
CROSSREF_PASSWORD=your-crossref-password
CROSSREF_PREFIX=10.50000

# Local Development
LOCAL_PRIVATE_STORAGE_ENABLED=false
